# ─────────────────────────────────────────────────────────────────────
# Variables d'environnement BS Couvreur (couvreur60.fr)
# Copiez ce fichier en .env localement, remplissez avec vos vraies valeurs.
# En production, configurer ces vars dans Coolify (Environment Variables).
# ─────────────────────────────────────────────────────────────────────

# ── Brevo API (envoi des emails de devis) ─────────────────────────────
# Clé API Brevo (https://app.brevo.com/settings/keys/api)
BREVO_API_KEY=xkeysib-...

# ── Expéditeur ─────────────────────────────────────────────────────────
# Doit être un domaine vérifié sur Brevo (DKIM/DMARC validés)
FROM_EMAIL=contact@couvreur60.fr
FROM_NAME=BS Couvreur

# ── Destinataires des notifications admin (séparés par virgule) ────────
ADMIN_EMAILS=entreprisebs95@gmail.com,jmoog27@gmail.com

# ── Anti-spam Cloudflare Turnstile ────────────────────────────────────
# Clé de SITE (publique) — exposée au navigateur, à définir en BUILD-TIME.
PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...
# Clé SECRÈTE — vérification serveur, à définir en RUNTIME (ne jamais exposer).
# Si absente, la vérification Turnstile est ignorée (le site continue de fonctionner).
TURNSTILE_SECRET_KEY=0x4AAAAAAA...
