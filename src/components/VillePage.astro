---
// ── Gabarit des pages villes desservies (zone de chalandise des deux établissements) ──
// Pas de NAP propre : chaque page est rattachée à son bureau (schema Service → provider).
import Layout from '../layouts/Layout.astro';
import AvisCarrousel from './AvisCarrousel.astro';
import { AVIS } from '../data/avis';
import {
  SITE_URL, NOM, SERVICES,
  TEL, TEL_HREF, ADRESSE_MONTIGNY,
  TEL_MAGNY, TEL_MAGNY_HREF, ADRESSE_MAGNY,
  MAPS_MONTIGNY, MAPS_MAGNY,
} from '../data/site';

export interface Props {
  title       : string;
  description : string;
  canonical   : string;            // ex: "/couvreur-saclay/"
  ville       : string;            // "Saclay"
  cp          : string;            // "91400"
  dept        : string;            // "Essonne" | "Yvelines"
  h1          : string;
  heroDesc    : string;            // problème client → couvreur → réponse (HTML autorisé)
  heroImg     : { src: string; alt: string };
  bureau      : 'magny' | 'montigny';
  avisNoms    : string[];          // noms des avis à afficher (rotation entre pages)
  avisTitle  ?: string;
  servicesTitle: string;           // H2 de la section prestations (unique par page)
  cards       : { signal: string; desc: string; anchor: string; alt: string }[]; // 6 cards, textes uniques
  ctaImg     ?: { src: string; alt: string }; // photo affichée à droite du CTA (optionnelle)
}

const {
  title, description, canonical, ville, cp, dept,
  h1, heroDesc, heroImg, bureau, avisNoms, avisTitle,
  servicesTitle, cards, ctaImg,
} = Astro.props;

// Photo du CTA (texte à gauche, image à droite) — défaut générique si non fournie
const ctaImage = ctaImg ?? {
  src: "/images/adnot-couvreur-yvelines-020.webp",
  alt: `Couvreur Adnot Couverture sur une toiture à ${ville}`,
};

// Photos des cards (variantes -800 générées, srcset retina)
const CARD_PHOTOS = [
  "/images/refection-toiture-yvelines-025.webp",
  "/images/reparation-toiture-yvelines-001.webp",
  "/images/demoussage-toiture-yvelines-005.webp",
  "/images/zinguerie-gouttiere-yvelines-010.webp",
  "/images/pose-velux-yvelines-004.webp",
  "/images/refection-toiture-yvelines-021.webp",
];
const SERVICES_CARDS = SERVICES.map((s, i) => ({
  ...s,
  photo: CARD_PHOTOS[i],
  ...cards[i],
}));

const BUREAUX = {
  magny: {
    nom: 'Magny-les-Hameaux', slug: '/couvreur-magny-les-hameaux/',
    tel: TEL_MAGNY, telHref: TEL_MAGNY_HREF, adresse: ADRESSE_MAGNY, maps: MAPS_MAGNY,
  },
  montigny: {
    nom: 'Montigny-le-Bretonneux', slug: '/couvreur-montigny-le-bretonneux/',
    tel: TEL, telHref: TEL_HREF, adresse: ADRESSE_MONTIGNY, maps: MAPS_MONTIGNY,
  },
};
const b = BUREAUX[bureau];

const avisVille = avisNoms
  .map(nom => AVIS.find(a => a.nom === nom))
  .filter(Boolean);

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Travaux de couverture",
  "name": `Travaux de couverture à ${ville}`,
  "description": description,
  "url": `${SITE_URL}${canonical}`,
  "provider": { "@id": `${SITE_URL}${b.slug}#etablissement` },
  "areaServed": {
    "@type": "City",
    "name": ville,
    "containedInPlace": { "@type": "AdministrativeArea", "name": dept },
  },
};
---

<Layout title={title} description={description} canonical={canonical} ogImage={heroImg.src} schema={schema} nap={{ tel: b.tel, telHref: b.telHref, adresse: b.adresse }}>

  <!-- ── HERO ── -->
  <section class="page-hero" aria-label={`Couvreur ${ville}`}>
    <div class="container page-hero__inner">
      <div>
        <nav class="breadcrumb" aria-label="Fil d'Ariane">
          <a href="/">Accueil</a>
          <span>›</span>
          <a href={b.slug}>Couvreur {b.nom}</a>
          <span>›</span>
          <span>{ville}</span>
        </nav>
        <span class="hero__badge">{NOM} — Francky et Warren Adnot</span>
        <h1>{h1}</h1>
        <p class="page-hero__desc" set:html={heroDesc} />
        <ul class="page-hero__list" style="list-style:none;padding:0;margin:0 0 1.5rem;display:flex;flex-direction:column;gap:.5rem;color:rgba(255,255,255,.92);font-size:.98rem;">
          <li style="display:flex;align-items:center;gap:.6rem;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--red-l)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><polyline points="20 6 9 17 4 12"/></svg>
            Devis et déplacement offerts
          </li>
          <li style="display:flex;align-items:center;gap:.6rem;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--red-l)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><polyline points="20 6 9 17 4 12"/></svg>
            Garantie décennale et responsabilité civile
          </li>
          <li style="display:flex;align-items:center;gap:.6rem;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--red-l)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><polyline points="20 6 9 17 4 12"/></svg>
            Intervention en moins de 24 heures en cas de fuite
          </li>
        </ul>
        <div class="page-hero__btns">
          <a href="/devis-gratuit/" class="btn btn--red">
            <img src="/icones/devis-gratuit.svg" alt="" width="16" height="16" class="icone icone--white" />
            Devis gratuit
          </a>
          <a href={b.telHref} class="btn btn--outline">
            <img src="/icones/telephone.svg" alt="" width="16" height="16" class="icone icone--white" />
            {b.tel}
          </a>
        </div>
      </div>
      <div class="page-hero__img-wrap">
        <img
          src={heroImg.src}
          alt={heroImg.alt}
          width="520" height="340"
          loading="eager"
          fetchpriority="high"
        />
        <div class="hero__garantie-band hero__garantie-band--progeas">
          <img src="/logo/logo-adnot-couverture-256.webp" alt="Logo Adnot Couverture" width="36" height="36" loading="eager" />
          <span style="display:flex;flex-direction:column;line-height:1.25;">
            <span>Francky et Warren Adnot</span>
            <small style="font-weight:600;font-size:.78rem;opacity:.7;">Ent Adnot Couverture</small>
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- ── PRESTATIONS (cards, textes uniques par ville) ── -->
  <section class="section" aria-labelledby="sec-services-ville">
    <div class="container">
      <div class="sec-head">
        <h2 id="sec-services-ville">{servicesTitle}</h2>
      </div>
      <div class="silos silos--3">
        {SERVICES_CARDS.map(s => (
          <div class="silo-card silo-card--photo" style="text-align:left;">
            <img class="silo-card__photo" src={s.photo.replace('.webp', '-800.webp')} srcset={`${s.photo.replace('.webp', '-800.webp')} 800w, ${s.photo} 1600w`} sizes="(min-width: 900px) 756px, 100vw" alt={s.alt} width="800" height="600" loading="lazy" />
            <div class="silo-card__body">
              <h3 style="text-align:left;">{s.titre}</h3>
              <p style="font-style:italic;color:var(--red-l);font-size:.92rem;margin-bottom:.6rem;text-align:left;line-height:1.5;hyphens:auto;">
                {s.signal}
              </p>
              <p style="text-align:left;line-height:1.65;hyphens:auto;margin-bottom:0;">
                {s.desc} <a href={s.slug} style="color:var(--red);font-weight:700;text-decoration:underline;">{s.anchor}</a>.
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── CONTENU + SIDEBAR ── -->
  <section class="content-wrap section--light">
    <div class="container">
      <div class="content-grid">

        <article class="content-body">
          <slot />
        </article>

        <aside>
          <div class="sidebar__card">
            <h3>Devis gratuit à {ville}</h3>
            <p>Devis et déplacement offerts — sans engagement</p>
            <hr class="sidebar__sep" />
            <div class="sidebar__tels">
              <div>
                <small>Téléphone</small>
                <a href={b.telHref}>
                  <img src="/icones/telephone.svg" alt="" width="14" height="14" class="icone" />
                  {b.tel}
                </a>
              </div>
            </div>
            <hr class="sidebar__sep" />
            <a href="/devis-gratuit/" class="btn btn--red btn--full" style="margin-top:.5rem;">
              Demander un devis
            </a>
            <div class="sidebar__garantie" style="margin-top:1.1rem;display:flex;flex-direction:column;align-items:center;gap:.5rem;text-align:center;">
              <img src="/logo/progeas_logo.png" alt="Garantie décennale" width="130" height="130" loading="lazy" style="width:130px;height:auto;flex-shrink:0;" />
              <span style="font-weight:700;font-size:.74rem;color:var(--dark);line-height:1.2;">Garantie décennale</span>
            </div>
          </div>

          <div class="sidebar__card" style="margin-top:1.5rem;">
            <h3 style="font-size:1rem;">Nos services</h3>
            <ul class="sidebar__links">
              {SERVICES.map(s => <li><a href={s.slug}>{s.titre}</a></li>)}
            </ul>
          </div>
        </aside>

      </div>
    </div>
  </section>

  <!-- ── AVIS ── -->
  {avisVille.length > 0 && (
    <AvisCarrousel avis={avisVille} titre={avisTitle ?? `Les avis de nos clients`} afficheTotal={false} mapsUrl={b.maps} />
  )}

  <!-- ── CTA (texte gauche + photo droite) ── -->
  <section class="cta-split" aria-label={`Devis couvreur ${ville}`}>
    <div class="container">
      <div class="cta-split__grid">
        <div class="cta-split__text">
          <h2 style="color:#fff;margin-bottom:1rem;">Besoin d'un couvreur à {ville} ?</h2>
          <p style="color:rgba(255,255,255,.88);line-height:1.65;text-align:left;margin-bottom:1.6rem;">Décrivez vos travaux par téléphone ou via le formulaire : un couvreur vient examiner la toiture et remet un devis poste par poste — offert, comme le déplacement.</p>
          <div class="hero__btns" style="margin-bottom:1.3rem;">
            <a href="/devis-gratuit/" class="btn btn--red">Demander un devis gratuit</a>
            <a href={b.telHref} class="btn btn--outline">
              <img src="/icones/telephone.svg" alt="" width="16" height="16" class="icone icone--white" />
              {b.tel}
            </a>
          </div>
          <p style="display:flex;align-items:center;gap:.6rem;font-size:.98rem;color:rgba(255,255,255,.9);margin:0;">
            <img src="/icones/pin-map.svg" alt="" width="18" height="18" class="icone icone--white" style="flex-shrink:0;" />
            Notre bureau&nbsp;: {b.adresse}
          </p>
        </div>
        <div class="cta-split__img">
          <img src={ctaImage.src} alt={ctaImage.alt} width="520" height="380" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

</Layout>
