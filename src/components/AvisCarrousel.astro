---
// ── Carrousel d'avis Google (utilisé par les pages établissements) ──
import { AVIS, NOTES_GOOGLE, type Avis, type VilleAvis } from '../data/avis';

export interface Props {
  ville?: string;           // page établissement : n'affiche que les avis de sa fiche
  avis?: Avis[];            // liste explicite (ex. sélection accueil)
  titre?: string;
  afficheTotal?: boolean;   // false = masque « — X avis sur notre fiche... »
  mapsUrl?: string;
}

const { ville, avis, titre, afficheTotal, mapsUrl } = Astro.props;

// Pages villes : uniquement les avis de leur fiche, hors sélection accueil
const avisAffiches = avis ?? AVIS.filter(a => a.ville === ville && !a.accueil);

const totalGlobal = Object.values(NOTES_GOOGLE).reduce((s, n) => s + n.total, 0);
const noteGoogle = ville
  ? (NOTES_GOOGLE[ville as VilleAvis] ?? NOTES_GOOGLE['Montigny-le-Bretonneux'])
  : { note: '5,0', total: totalGlobal };
const mentionFiche = ville ? `notre fiche Google de ${ville}` : 'nos fiches Google';
---

<section class="section" aria-labelledby="sec-avis">
  <div class="container">
    <div class="sec-head">
      <h2 id="sec-avis">{titre ?? 'Les avis de nos clients'}</h2>
      <p style="margin:.8rem auto 0;">
        <span style="color:#F5B301;font-size:1.1rem;letter-spacing:.1em;">★★★★★</span>
        &nbsp;<strong>{noteGoogle.note} sur 5</strong>{afficheTotal !== false && ` — ${noteGoogle.total} avis sur ${mentionFiche}`}
      </p>
    </div>

    <div style="position:relative;">
      <div class="avis-track" id="avis-track" style="display:flex;gap:1.2rem;overflow-x:auto;scroll-snap-type:x mandatory;padding:.25rem .25rem 1rem;scrollbar-width:thin;">
        {avisAffiches.map(a => (
          <article style="flex:0 0 320px;max-width:320px;scroll-snap-align:start;background:#fff;border:1px solid var(--border, #E5E7EB);border-radius:var(--r);box-shadow:var(--shadow, 0 2px 10px rgba(0,0,0,.05));padding:1.4rem;display:flex;flex-direction:column;gap:.6rem;">
            <div style="color:#F5B301;letter-spacing:.12em;" aria-label={`${a.note} étoiles sur 5`}>★★★★★</div>
            <p style="margin:0;font-size:.95rem;line-height:1.6;flex:1;">{a.texte}</p>
            <footer style="font-size:.85rem;color:var(--muted, #6B7280);">
              <strong style="color:inherit;">{a.nom}</strong> · {a.date} · Avis Google
            </footer>
          </article>
        ))}
      </div>
      <button type="button" class="avis-nav" data-dir="-1" aria-label="Avis précédents" style="position:absolute;left:-.5rem;top:50%;transform:translateY(-50%);width:38px;height:38px;border-radius:50%;border:1px solid #E5E7EB;background:#fff;box-shadow:0 2px 8px rgba(0,0,0,.12);cursor:pointer;font-size:1.1rem;line-height:1;">‹</button>
      <button type="button" class="avis-nav" data-dir="1" aria-label="Avis suivants" style="position:absolute;right:-.5rem;top:50%;transform:translateY(-50%);width:38px;height:38px;border-radius:50%;border:1px solid #E5E7EB;background:#fff;box-shadow:0 2px 8px rgba(0,0,0,.12);cursor:pointer;font-size:1.1rem;line-height:1;">›</button>
    </div>

    {mapsUrl && (
      <p style="text-align:center;margin:1.2rem 0 0;">
        <a href={mapsUrl} target="_blank" rel="noopener" style="color:var(--blue, #185E97);font-weight:700;text-decoration:underline;">Voir tous les avis sur notre fiche Google</a>
      </p>
    )}
  </div>
</section>

<script is:inline>
  (function () {
    var track = document.getElementById('avis-track');
    if (!track) return;
    document.querySelectorAll('.avis-nav').forEach(function (btn) {
      btn.addEventListener('click', function () {
        track.scrollBy({ left: 340 * Number(btn.dataset.dir), behavior: 'smooth' });
      });
    });
  })();
</script>
