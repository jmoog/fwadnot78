---
// ── Gabarit des pages établissements (NAP propre à chaque fiche Google) ──
// Note : les pages services affichent les DEUX adresses (couverture départementale) ;
// ici, chaque page n'affiche que le NAP de son établissement.
import Layout from '../layouts/Layout.astro';
import { SITE_URL, NOM, FONDATEURS, EMAIL, SIRET, SERVICES, SECTEURS } from '../data/site';
import AvisCarrousel from './AvisCarrousel.astro';

export interface Props {
  title       : string;
  description : string;
  canonical   : string;
  ville       : string;             // "Montigny-le-Bretonneux"
  h1          : string;
  h1Sub       : string;
  heroDesc    : string;
  heroImg     : { src: string; alt: string };
  adresse     : string;             // NAP affiché
  rue         : string;             // schema streetAddress
  cp          : string;
  tel         : string;             // numéro principal affiché sur CETTE page
  telHref     : string;
  telFixe    ?: { num: string; href: string };  // second numéro éventuel
  geo        ?: { lat: number; lng: number };
  sameAs     ?: string[];
  servicesTitle?: string;
  servicesIntro?: string;
  cardsTexts   ?: { signal?: string; desc?: string; alt?: string }[];  // textes uniques par page (anti-duplication)
  avisTitle    ?: string;             // titre de la section avis
  avisAfficheTotal ?: boolean;        // false = masque « — X avis sur notre fiche... »
  avisPosition ?: 'hero' | 'services'; // emplacement du carrousel (défaut : sous les prestations)
  villesProches?: { nom: string; slug: string }[]; // pages villes desservies par ce bureau (maillage)
  galerie     : { src: string; alt: string }[];
  galerieTitle: string;
  portraitTitle: string;
  ctaTitle    : string;
}

const {
  title, description, canonical, ville, h1, h1Sub, heroDesc, heroImg,
  adresse, rue, cp, tel, telHref, telFixe, geo, sameAs,
  servicesTitle, servicesIntro, cardsTexts, avisTitle, avisAfficheTotal, avisPosition, villesProches,
  galerie, galerieTitle, portraitTitle, ctaTitle,
} = Astro.props;

const secServicesTitle = servicesTitle ?? `Nos prestations à ${ville}`;
const secServicesIntro = servicesIntro ?? `Réfection, réparation, démoussage, zinguerie, Velux et isolation : six prestations réalisées à ${ville} et dans les communes voisines, détaillées sur leurs pages dédiées.`;

const autreSecteur = SECTEURS.filter(s => s.slug !== canonical);

// ── Cards services contextualisées par ville ──
// Jeux de photos distincts par établissement (et différents des cards de la home)
const CARD_PHOTOS: Record<string, string[]> = {
  "Montigny-le-Bretonneux": [
    "/images/refection-toiture-yvelines-025.webp",
    "/images/reparation-toiture-yvelines-021.webp",
    "/images/traitement-toiture-yvelines-001.webp",
    "/images/zinguerie-gouttiere-yvelines-010.webp",
    "/images/pose-velux-yvelines-004.webp",
    "/images/refection-toiture-yvelines-009.webp",
  ],
  "Magny-les-Hameaux": [
    "/images/refection-toiture-yvelines-025.webp",
    "/images/reparation-toiture-yvelines-001.webp",
    "/images/demoussage-toiture-yvelines-005.webp",
    "/heroe/zinguerie-gouttiere-yvelines-001.webp",
    "/heroe/pose-velux-yvelines-019.webp",
    "/images/refection-toiture-yvelines-021.webp",
  ],
};
const cardPhotos = CARD_PHOTOS[ville] ?? CARD_PHOTOS["Montigny-le-Bretonneux"];

const DEFAULT_CARDS = [
  { ...SERVICES[0], photo: { src: cardPhotos[0], alt: `Réfection de toiture par Adnot Couverture près de ${ville}` },          signal: `Une toiture en fin de vie à ${ville} ?`,            desc: "Dépose complète, écran de sous-toiture, liteaux neufs et couverture reposée, faîtage compris. Voir le détail de la",  anchor: "réfection de toiture dans les Yvelines" },
  { ...SERVICES[1], photo: { src: cardPhotos[1], alt: `Réparation de couverture par un couvreur Adnot près de ${ville}` },     signal: `Une fuite ou des tuiles cassées à ${ville} ?`,      desc: "Recherche de fuite, remplacement des éléments touchés, mise hors d'eau si besoin. Plus d'infos sur la",               anchor: "réparation de toiture dans les Yvelines" },
  { ...SERVICES[2], photo: { src: cardPhotos[2], alt: `Démoussage de toiture par Adnot Couverture près de ${ville}` },         signal: `Des tuiles gagnées par la mousse à ${ville} ?`,     desc: "Brossage, traitement anti-mousse et hydrofuge, photos avant / après remises. Voir le détail du",                      anchor: "démoussage de toiture dans les Yvelines" },
  { ...SERVICES[3], photo: { src: cardPhotos[3], alt: `Travaux de zinguerie par Adnot Couverture près de ${ville}` },          signal: `Une gouttière qui déborde à ${ville} ?`,            desc: "Pose et remplacement en zinc, aluminium ou PVC, solins et abergements compris. Voir le détail des",                   anchor: "gouttières et de la zinguerie dans le 78" },
  { ...SERVICES[4], photo: { src: cardPhotos[4], alt: `Pose de Velux par Adnot Couverture près de ${ville}` },                 signal: `Une fenêtre de toit à poser à ${ville} ?`,          desc: "Création d'ouverture ou remplacement, raccords d'étanchéité et finitions. Voir la",                                   anchor: "pose de Velux dans les Yvelines" },
  { ...SERVICES[5], photo: { src: cardPhotos[5], alt: `Isolation de toiture par Adnot Couverture près de ${ville}` },          signal: `Des combles à isoler à ${ville} ?`,                 desc: "Sarking, entre chevrons ou soufflage, ventilation de la couverture préservée. Plus d'infos sur l'",                   anchor: "isolation de toiture dans les Yvelines" },
];

// Textes par page si fournis (contenu unique), photos et ancres conservées
const SERVICES_CARDS = DEFAULT_CARDS.map((c, i) => {
  const t = cardsTexts?.[i];
  return {
    ...c,
    signal: t?.signal ?? c.signal,
    desc: t?.desc ?? c.desc,
    photo: { ...c.photo, alt: t?.alt ?? c.photo.alt },
  };
});

const schema = {
  "@context": "https://schema.org",
  "@type": "RoofingContractor",
  "@id": `${SITE_URL}${canonical}#etablissement`,
  "name": `${NOM} — ${ville}`,
  "alternateName": `${FONDATEURS}, couvreurs à ${ville}`,
  "description": description,
  "url": `${SITE_URL}${canonical}`,
  "telephone": telHref.replace('tel:', ''),
  "email": EMAIL,
  "image": `${SITE_URL}${heroImg.src}`,
  "logo": `${SITE_URL}/logo/logo-adnot-couverture-couvreur-dans-les-yvelines.png`,
  "parentOrganization": { "@id": `${SITE_URL}/#organization` },
  "founder": [
    { "@type": "Person", "name": "Francky Adnot", "jobTitle": "Couvreur" },
    { "@type": "Person", "name": "Warren Adnot",  "jobTitle": "Couvreur" },
  ],
  "identifier": { "@type": "PropertyValue", "name": "SIRET", "value": SIRET },
  "address": {
    "@type": "PostalAddress",
    "streetAddress": rue,
    "addressLocality": ville,
    "postalCode": cp,
    "addressRegion": "Île-de-France",
    "addressCountry": "FR"
  },
  "areaServed": {
    "@type": "City",
    "name": ville,
    "containedInPlace": { "@type": "AdministrativeArea", "name": "Yvelines" }
  },
  ...(geo && { "geo": { "@type": "GeoCoordinates", "latitude": geo.lat, "longitude": geo.lng } }),
  ...(sameAs && { "sameAs": sameAs, "hasMap": sameAs[0] }),
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": `Travaux de couverture à ${ville}`,
    "itemListElement": SERVICES.map((s) => ({
      "@type": "Offer",
      "itemOffered": { "@type": "Service", "name": s.titre, "url": `${SITE_URL}${s.slug}` },
    })),
  },
  "priceRange": "€€",
};
---

<Layout title={title} description={description} canonical={canonical} ogImage={heroImg.src} schema={schema} nap={{ tel, telHref, adresse }}>

  <!-- ── HERO (même structure que la home, photo à la place de la vidéo) ── -->
  <section class="hero" aria-label={`Couvreur ${ville}`}>
    <div class="container hero__inner">

      <div class="hero__text">
        <nav class="breadcrumb" aria-label="Fil d'Ariane">
          <a href="/">Accueil</a>
          <span>›</span>
          <span>Couvreur {ville}</span>
        </nav>

        <p class="hero__eyebrow">{h1Sub}</p>

        <h1>{h1}</h1>

        <p class="hero__sub" style="text-align:left;" set:html={heroDesc} />

        <ul class="hero__list" style="list-style:none;padding:0;margin:0 0 1.5rem;grid-template-columns:1fr;gap:.5rem;color:rgba(255,255,255,.92);font-size:.98rem;">
          <li style="display:flex;align-items:center;gap:.6rem;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--red-l)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><polyline points="20 6 9 17 4 12"/></svg>
            Devis gratuit et déplacement offert
          </li>
          <li style="display:flex;align-items:center;gap:.6rem;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--red-l)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><polyline points="20 6 9 17 4 12"/></svg>
            Garantie décennale
          </li>
          <li style="display:flex;align-items:center;gap:.6rem;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--red-l)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><polyline points="20 6 9 17 4 12"/></svg>
            Assurance responsabilité civile
          </li>
        </ul>

        <div class="hero__btns">
          <a href="/devis-gratuit/" class="btn btn--red">
            <svg class="icone" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
            Devis gratuit
          </a>
          <a href={telHref} class="btn btn--outline">
            <svg class="icone" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.45 2 2 0 0 1 3.59 1.27h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.83a16 16 0 0 0 6 6l.92-.92a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21.73 16.92z"/></svg>
            {tel}
          </a>
        </div>
      </div>

      <div class="hero__img-wrap">
        <img
          src={heroImg.src}
          alt={heroImg.alt}
          width="1280" height="720"
          loading="eager"
          fetchpriority="high"
          style="width:100%;aspect-ratio:16/9;object-fit:cover;border-radius:var(--r) var(--r) 0 0;box-shadow:var(--shadow-lg);display:block;"
        />
        <div class="hero__garantie-band hero__garantie-band--progeas">
          <img src="/logo/progeas_logo.png" alt="Progeas — assurance garantie décennale d'Adnot Couverture" width="101" height="28" loading="eager" />
          Notre garantie décennale
        </div>
      </div>

    </div>
  </section>

  {avisPosition === 'hero' && (
    <AvisCarrousel ville={ville} titre={avisTitle} afficheTotal={avisAfficheTotal} mapsUrl={sameAs?.[0]} />
  )}

  <!-- ── SERVICES ── -->
  <section class="section" aria-labelledby="sec-services">
    <div class="container">
      <div class="sec-head">
        <h2 id="sec-services">{secServicesTitle}</h2>
        <p style="text-align:left;max-width:780px;margin:.8rem auto 0;">
          {secServicesIntro}
        </p>
      </div>
      <div class="silos silos--3">
        {SERVICES_CARDS.map(s => (
          <div class="silo-card silo-card--photo" style="text-align:left;">
            <img class="silo-card__photo" src={s.photo.src.replace('.webp', '-800.webp')} srcset={`${s.photo.src.replace('.webp', '-800.webp')} 800w, ${s.photo.src} 1600w`} sizes="(min-width: 900px) 756px, 100vw" alt={s.photo.alt} width="800" height="600" loading="lazy" />
            <div class="silo-card__body">
              <h3 style="text-align:left;">{s.titre}</h3>
              <p style="font-style:italic;color:var(--red-l);font-size:.92rem;margin-bottom:.6rem;text-align:left;line-height:1.5;hyphens:auto;">
                {s.signal}
              </p>
              <p style="text-align:left;line-height:1.65;hyphens:auto;margin-bottom:0;">
                {s.desc} <a href={s.slug} style="color:var(--red);font-weight:700;text-decoration:underline;">{s.anchor}</a>.
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {avisPosition !== 'hero' && (
    <AvisCarrousel ville={ville} titre={avisTitle} afficheTotal={avisAfficheTotal} mapsUrl={sameAs?.[0]} />
  )}

  <!-- ── CONTENU SEO ── -->
  <section class="content-wrap section--light">
    <div class="container">
      <div class="content-grid">
        <article class="content-body">
          <slot />
        </article>

        <!-- Sidebar -->
        <aside>
          <div class="sidebar__card">
            <h3>Devis gratuit à {ville}</h3>
            <p>Devis et déplacement offerts — sans engagement</p>
            <hr class="sidebar__sep" />
            <div class="sidebar__tels">
              <div>
                <small>Téléphone</small>
                <a href={telHref}>
                  <img src="/icones/telephone.svg" alt="" width="14" height="14" class="icone" />
                  {tel}
                </a>
              </div>
              {telFixe && (
                <div>
                  <small>Fixe</small>
                  <a href={telFixe.href}>
                    <img src="/icones/telephone.svg" alt="" width="14" height="14" class="icone" />
                    {telFixe.num}
                  </a>
                </div>
              )}
            </div>
            <hr class="sidebar__sep" />
            <a href="/devis-gratuit/" class="btn btn--red btn--full" style="margin-top:.5rem;">
              Demander un devis
            </a>
            <div class="sidebar__addr">
              <img src="/icones/pin-map.svg" alt="" width="13" height="13" class="icone" />
              {adresse}
            </div>
            {sameAs && sameAs[0] && (
              <div style="margin-top:.8rem;">
                <a href={sameAs[0]} target="_blank" rel="noopener" style="font-size:.85rem;font-weight:600;">Notre fiche Google à {ville} ↗</a>
              </div>
            )}
          </div>

          <div class="sidebar__card" style="margin-top:1.5rem;">
            <h3 style="font-size:1rem;">Nos services</h3>
            <ul class="sidebar__links">
              {SERVICES.map(s => <li><a href={s.slug}>{s.titre}</a></li>)}
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- ── PORTRAIT ── -->
  <section class="portrait-section" aria-labelledby="sec-portrait">
    <div class="container">
      <div class="portrait-grid">
        <div class="portrait-grid__img">
          <img
            src="/images/adnot-couvreur-yvelines-020.webp"
            alt={`Couvreur Adnot sur une toiture à ${ville}`}
            width="600" height="800"
            loading="lazy"
          />
        </div>
        <div class="portrait-grid__content">
          <h2 id="sec-portrait">{portraitTitle}</h2>
          <p>
            Adnot Couverture, c'est deux frères sur les toits : <strong>celui qui
            établit le devis est celui qui monte sur votre couverture</strong>.
            Vous suivez le chantier sur les photos prises avant, pendant et
            après les travaux, complétées au drone pour les vues d'ensemble.
          </p>
          <p>
            Couverture, charpente, ramonage et peinture : un seul interlocuteur,
            joignable au bureau de {ville} comme sur les chantiers. L'ensemble
            de nos travaux est couvert par la garantie décennale.
          </p>
          <ul class="portrait-list" style="list-style:none;padding:0;margin:1.5rem 0 0;display:flex;flex-direction:column;gap:.55rem;">
            <li style="display:flex;align-items:center;gap:.7rem;color:rgba(255,255,255,.92);font-size:.98rem;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--red-l)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><polyline points="20 6 9 17 4 12"/></svg>
              Deux frères, un seul interlocuteur du devis à la réception
            </li>
            <li style="display:flex;align-items:center;gap:.7rem;color:rgba(255,255,255,.92);font-size:.98rem;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--red-l)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><polyline points="20 6 9 17 4 12"/></svg>
              Un bureau à {ville}, des chantiers suivis sur place
            </li>
            <li style="display:flex;align-items:center;gap:.7rem;color:rgba(255,255,255,.92);font-size:.98rem;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--red-l)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><polyline points="20 6 9 17 4 12"/></svg>
              Couverture, charpente, ramonage et peinture
            </li>
            <li style="display:flex;align-items:center;gap:.7rem;color:rgba(255,255,255,.92);font-size:.98rem;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--red-l)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><polyline points="20 6 9 17 4 12"/></svg>
              Devis et déplacement offerts, garantie décennale
            </li>
          </ul>
          <p style="margin:1.6rem 0 0;display:flex;align-items:center;gap:.7rem;color:#fff;font-size:1.3rem;font-weight:800;line-height:1.4;">
            <img src="/icones/pin-map.svg" alt="" width="24" height="24" class="icone icone--white" style="flex-shrink:0;" />
            {adresse}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── GALERIE PHOTOS ── -->
  <section class="section section--light" aria-label={galerieTitle}>
    <div class="container">
      <div class="sec-head">
        <h2>{galerieTitle}</h2>
      </div>
      <div class="galerie">
        {galerie.map(p => (
          <div class="galerie__item">
            <img src={p.src} alt={p.alt} loading="lazy" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── CTA ── -->
  <section class="cta" aria-label={ctaTitle}>
    <div class="container" style="text-align:center;">
      <h2>{ctaTitle}</h2>
      <p>Un toit qui prend de l'âge, des tuiles à remplacer, une couverture à entretenir : décrivez vos travaux par téléphone ou via le formulaire, un couvreur vient examiner la toiture et chiffre poste par poste.</p>
      <div class="hero__btns" style="justify-content:center;">
        <a href="/devis-gratuit/" class="btn btn--red">Demander un devis gratuit</a>
        <a href={telHref} class="btn btn--outline">
          <img src="/icones/telephone.svg" alt="" width="16" height="16" class="icone icone--white" />
          {tel}
        </a>
      </div>
      <p style="margin:1.4rem 0 0;display:flex;align-items:center;justify-content:center;gap:.6rem;font-size:.98rem;opacity:.92;">
        <img src="/icones/pin-map.svg" alt="" width="18" height="18" class="icone icone--white" style="flex-shrink:0;" />
        Notre bureau&nbsp;: {adresse}
      </p>
    </div>
  </section>

  <!-- ── AUTRE SECTEUR (maillage interne) ── -->
  {autreSecteur.length > 0 && (
    <section class="section" aria-labelledby="sec-voisines">
      <div class="container">
        <div class="sec-head">
          <h2 id="sec-voisines">{NOM} intervient aussi près de {ville}</h2>
        </div>
        <div class="cluster__villes" style="justify-content:center;">
          {autreSecteur.map(s => (
            <a href={s.slug} class="ville-pill">
              <strong>{s.nom}</strong>
            </a>
          ))}
          {(villesProches ?? []).map(v => (
            <a href={v.slug} class="ville-pill">{v.nom}</a>
          ))}
        </div>
      </div>
    </section>
  )}

</Layout>
