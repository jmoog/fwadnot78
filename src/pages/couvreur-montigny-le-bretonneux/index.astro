    { src: "/images/refection-toiture-yvelines-081.webp",   alt: "Réfection de couverture près de Montigny-le-Bretonneux" },
    { src: "/images/reparation-toiture-yvelines-016.webp",  alt: "Réparation de toiture par Adnot Couverture à Montigny-le-Bretonneux" },
