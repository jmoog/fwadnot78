  description="Mentions légales du site ent-adnot-couverture.fr — Adnot Couverture, entreprise de couverture dans les Yvelines (78)."
  canonical="/mentions-legales/"
  noindex={true}
>
  <section class="section">
    <div class="container">
      <div class="static-wrap">
        <h1 style="color:var(--blue);margin-bottom:2rem;">Mentions légales</h1>

        <p>
          Le site accessible à l'adresse <a href="https://ent-adnot-couverture.fr/">https://ent-adnot-couverture.fr/</a>
