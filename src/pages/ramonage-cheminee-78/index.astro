  .ramonage-table th, .ramonage-table td { text-align: left; padding: .6rem .8rem; border-bottom: 1px solid var(--border); vertical-align: top; }
  .ramonage-table th { color: var(--blue); font-weight: 700; }
  .ramonage-table td:first-child { font-weight: 600; white-space: nowrap; }
</style>
