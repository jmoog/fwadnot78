---
import Layout from '../layouts/Layout.astro';
import { TEL, TEL_HREF, SERVICES, SECTEURS } from '../data/site';
---

<Layout
  title="Page introuvable — Adnot Couverture, Yvelines (78)"
  description="La page que vous cherchez n'existe pas ou plus. Retrouvez les services et secteurs d'intervention d'Adnot Couverture dans les Yvelines."
  noindex={true}
>
  <section class="section" style="padding-top:4rem;padding-bottom:4rem;">
    <div class="container" style="max-width:800px;text-align:center;">

      <p style="font-size:5rem;font-weight:800;color:var(--red);margin:0;line-height:1;">404</p>
      <h1 style="font-size:1.8rem;color:var(--blue);margin:.8rem 0 1rem;">Cette page n'existe pas (ou plus)</h1>
      <p style="font-size:1.05rem;color:#475569;max-width:560px;margin:0 auto 2rem;">
        L'adresse a peut-être changé lors d'une mise à jour du site, ou
        contient une faute de frappe. Les liens ci-dessous mènent à nos
        prestations et à nos deux bureaux.
      </p>

      <div style="display:flex;gap:.8rem;justify-content:center;flex-wrap:wrap;margin-bottom:3rem;">
        <a href="/" class="btn btn--blue">Retour à l'accueil</a>
        <a href="/devis-gratuit/" class="btn btn--red">Demander un devis</a>
        <a href={TEL_HREF} class="btn btn--outline-dark">{TEL}</a>
      </div>

      <h2 style="font-size:1.2rem;color:var(--blue);margin-bottom:1.2rem;">Vous cherchiez peut-être&nbsp;:</h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1rem;text-align:left;">
        {SERVICES.map(s => (
          <a href={s.slug} style="display:block;padding:1rem 1.2rem;background:#fff;border:1px solid #E2E8F0;border-radius:8px;text-decoration:none;color:var(--blue);font-weight:600;">
            {s.titre}
          </a>
        ))}
        {SECTEURS.map(s => (
          <a href={s.slug} style="display:block;padding:1rem 1.2rem;background:#fff;border:1px solid #E2E8F0;border-radius:8px;text-decoration:none;color:var(--blue);font-weight:600;">
            Couvreur {s.nom}
          </a>
        ))}
      </div>

    </div>
  </section>
</Layout>
