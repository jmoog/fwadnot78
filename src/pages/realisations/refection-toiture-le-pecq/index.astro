---
import RealisationPage from '../../../components/RealisationPage.astro';

const ph = (nom: string, alt: string, w: number, h: number, caption?: string) => ({
  src: `/images/${nom}.webp`, src800: `/images/${nom}-800.webp`, alt, w, h, caption,
});

const hero = ph("refection-toiture-le-pecq-78-34", "Toiture à plusieurs pans refaite à neuf au Pecq par Adnot Couverture", 1600, 1200);
const avant = ph("refection-toiture-le-pecq-78-01", "Ancienne couverture déposée sur un pan de toiture au Pecq", 1200, 1600);
const apres = ph("refection-toiture-le-pecq-78-17", "Tuiles neuves en terre cuite Terreal sur un pan terminé au Pecq", 1200, 1600);

const galerie = [
  ph("refection-toiture-le-pecq-78-03", "Toiture ouverte au niveau de la noue, charpente apparente", 1600, 1200, "La noue ouverte, charpente apparente."),
  ph("refection-toiture-le-pecq-78-06", "Pan de toiture protégé par une bâche pendant la dépose", 1200, 1600, "Les pans ouverts restent bâchés."),
  ph("refection-toiture-le-pecq-78-10", "Écran sous-toiture HPV et liteaux neufs posés au Pecq", 1200, 1600, "Écran sous-toiture HPV et liteaux neufs."),
  ph("refection-toiture-le-pecq-78-13", "Pose des tuiles neuves rang par rang sur la toiture du Pecq", 1200, 1600, "Pose des tuiles rang par rang."),
  ph("refection-toiture-le-pecq-78-26", "Arêtier refait avec des faîtières neuves au Pecq", 1200, 1600, "Arêtier refait avec des faîtières neuves."),
  ph("refection-toiture-le-pecq-78-31", "Faîtage neuf sur la toiture refaite au Pecq", 1200, 1600, "Le faîtage neuf."),
];
---

<RealisationPage
  title="Réfection de toiture au Pecq (78) — Adnot Couverture"
  description="Toiture à plusieurs pans refaite à neuf au Pecq : dépose, écran sous-toiture, liteaux et tuiles neuves, faîtages et arêtiers. Chantier de l'été 2024."
  canonical="/realisations/refection-toiture-le-pecq/"
  h1="Une toiture refaite à neuf au Pecq"
  lede="Plusieurs pans, une noue, des arêtiers : la couverture de cette maison du Pecq était usée sur tous ses versants. Nous l'avons entièrement refaite pendant l'été 2024, de la dépose des anciennes tuiles jusqu'au dernier faîtage."
  breadcrumb="Réfection de toiture au Pecq"
  datePublished="2026-10-04"
  lieu={{ nom: "Le Pecq", cp: "78230" }}
  chips={["Réfection complète", "Tuiles terre cuite Terreal", "Écran sous-toiture HPV", "Été 2024"]}
  bureau="montigny"
  hero={hero}
  galerie={galerie}
  galerieTitle="Le chantier du Pecq en images"
  sidebarTitle="Devis gratuit au Pecq"
  liens={[
    { href: "/refection-de-toiture-78/", label: "Réfection de toiture" },
    { href: "/reparation-de-toiture-78/", label: "Réparation de toiture" },
    { href: "/couvreur-montigny-le-bretonneux/", label: "Notre bureau de Montigny-le-Bretonneux" },
  ]}
  ctaTitle="Contactez votre couvreur au Pecq"
  ctaDesc="Votre toiture montre les mêmes signes d'usure ? Francky et Warren étudient avec vous la réfection de votre couverture, que votre toit soit simple ou découpé. <strong>Le devis est gratuit et sans engagement.</strong>"
  ctaImg={galerie[4]}
>
  <h2>Une couverture usée sur tous les pans</h2>
  <div class="media-row">
    <div>
      <p>
        Les anciennes tuiles avaient perdu leur teinte, la mousse s'était
        installée et plusieurs éléments étaient fragilisés. Sur une toiture
        aussi découpée, tous les raccords comptent : la noue, les arêtiers et
        les rives sont les premiers points d'infiltration.
      </p>
      <p>
        Remplacer quelques tuiles n'aurait fait que repousser le problème.
        Nous avons proposé la
        <a href="/refection-de-toiture-78/">réfection complète de la couverture</a>.
      </p>
    </div>
    <figure class="media-figure">
      <img
        src={avant.src800}
        srcset={`${avant.src800} 800w, ${avant.src} 1200w`}
        sizes="(min-width: 780px) 360px, 100vw"
        alt={avant.alt}
        width="1200" height="1600" loading="lazy"
      />
      <figcaption>L'ancienne couverture, en cours de dépose.</figcaption>
    </figure>
  </div>

  <h2>Les travaux, pan par pan</h2>
  <ul class="chantier-points">
    <li>dépose des anciennes tuiles et des liteaux, pan par pan, la partie ouverte protégée sous bâche ;</li>
    <li>pose d'un <strong>écran sous-toiture HPV</strong>, qui protège la charpente tout en laissant respirer les combles ;</li>
    <li>pose de liteaux neufs, traités ;</li>
    <li>pose des <strong>tuiles neuves en terre cuite Terreal</strong>, à emboîtement, de teinte brune ;</li>
    <li>reprise de la noue, des arêtiers et des faîtages avec des faîtières neuves.</li>
  </ul>

  <h2>Une toiture neuve, étanche et homogène</h2>
  <div class="media-row">
    <div>
      <p>
        La maison a retrouvé une toiture d'une seule teinte, sans tuile cassée
        ni mousse. L'écran sous-toiture protège le bois de charpente, et les
        faîtages neufs ferment le sommet des pans.
      </p>
      <p>
        Une couverture refaite dans les règles de l'art, pour de longues
        années de tranquillité.
      </p>
    </div>
    <figure class="media-figure">
      <img
        src={apres.src800}
        srcset={`${apres.src800} 800w, ${apres.src} 1200w`}
        sizes="(min-width: 780px) 360px, 100vw"
        alt={apres.alt}
        width="1200" height="1600" loading="lazy"
      />
      <figcaption>Un pan terminé, en tuiles neuves.</figcaption>
    </figure>
  </div>
</RealisationPage>
