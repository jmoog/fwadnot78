---
import RealisationPage from '../../../components/RealisationPage.astro';

const ph = (nom: string, alt: string, w: number, h: number, caption?: string) => ({
  src: `/images/${nom}.webp`, src800: `/images/${nom}-800.webp`, alt, w, h, caption,
});

const hero    = ph("reparation-faitage-voisins-le-bretonneux-78-04", "Toiture en tuiles rouges nettoyée à Voisins-le-Bretonneux, faîtage refait", 1600, 1200);
const avant   = ph("demoussage-toiture-voisins-le-bretonneux-78-01-avant", "Toiture couverte de mousse avant nettoyage à Voisins-le-Bretonneux", 1200, 1600);
const closoir = ph("reparation-faitage-voisins-le-bretonneux-78-03", "Closoir ventilé posé sur la lisse de faîtage à Voisins-le-Bretonneux", 1200, 1600);

const galerie = [
  ph("demoussage-toiture-voisins-le-bretonneux-78-02", "Nettoyage en cours, une partie de la toiture déjà débarrassée de la mousse", 1200, 1600, "Le nettoyage en cours."),
  ph("demoussage-toiture-voisins-le-bretonneux-78-03-apres", "Toiture nettoyée, tuiles rouges et fenêtres de toit dégagées", 1200, 1600, "La couverture nettoyée."),
  ph("reparation-faitage-voisins-le-bretonneux-78-01", "Ancien faîtage déposé, reste de mortier au sommet de la toiture", 1200, 1600, "L'ancien faîtage déposé."),
  ph("reparation-faitage-voisins-le-bretonneux-78-02", "Lisse de faîtage posée au sommet de la toiture", 1200, 1600, "La lisse de faîtage en place."),
  ph("reparation-faitage-voisins-le-bretonneux-78-06", "Faîtières fixées une à une par vis sur le closoir", 1200, 1600, "Les faîtières fixées une à une."),
  ph("reparation-faitage-voisins-le-bretonneux-78-07", "Faîtière en about contre le mur voisin, raccord repris", 1200, 1600, "Le raccord contre le mur voisin."),
  ph("reparation-faitage-voisins-le-bretonneux-78-05", "Faîtage terminé vu de près, closoir sous les faîtières", 1600, 1200, "Le faîtage terminé."),
  ph("pose-velux-voisins-le-bretonneux-78-08", "Fenêtre de toit posée avec son raccord d'étanchéité, tuiles reposées autour", 1200, 1600, "Au printemps 2026 : une fenêtre de toit posée."),
];
---

<RealisationPage
  title="Démoussage et faîtage à Voisins-le-Bretonneux — Adnot Couverture"
  description="À Voisins-le-Bretonneux, une toiture verte de mousse nettoyée, puis son faîtage refait à sec avec closoir ventilé. Été 2024, fenêtre de toit posée en 2026."
  canonical="/realisations/demoussage-faitage-voisins-le-bretonneux/"
  h1="Une toiture nettoyée et un faîtage refait à Voisins-le-Bretonneux"
  lede="Sur cette maison de Voisins-le-Bretonneux, la toiture verdissait et le faîtage scellé au mortier se fissurait. Deux signes qui annoncent des infiltrations si on les laisse s'installer. À l'été 2024, nous avons traité les deux, l'un après l'autre."
  breadcrumb="Démoussage et faîtage à Voisins"
  datePublished="2026-10-04"
  lieu={{ nom: "Voisins-le-Bretonneux", cp: "78960" }}
  chips={["Démoussage", "Faîtage à sec", "Closoir ventilé", "Été 2024"]}
  bureau="montigny"
  hero={hero}
  galerie={galerie}
  galerieTitle="Le chantier de Voisins-le-Bretonneux en images"
  sidebarTitle="Devis gratuit à Voisins"
  liens={[
    { href: "/couvreur-voisins-le-bretonneux/", label: "Couvreur à Voisins-le-Bretonneux" },
    { href: "/demoussage-de-toiture-78/", label: "Démoussage et nettoyage" },
    { href: "/reparation-de-toiture-78/", label: "Réparation de toiture" },
  ]}
  ctaTitle="Contactez votre couvreur à Voisins-le-Bretonneux"
  ctaDesc="Une toiture qui verdit, du mortier tombé dans la gouttière ? Francky et Warren vérifient votre couverture et votre faîtage. <strong>Le devis est gratuit et sans engagement.</strong>"
  ctaImg={galerie[6]}
>
  <h2>Le besoin : stopper la mousse et refermer le sommet du toit</h2>
  <div class="media-row">
    <div>
      <p>
        La mousse avait gagné toute la couverture. Elle retient l'eau contre
        les tuiles, les rend poreuses et finit par les soulever.
      </p>
      <p>
        Au sommet, le mortier qui tenait les faîtières se fissurait. Un
        faîtage qui s'ouvre laisse passer l'eau directement vers les combles,
        sans que rien ne se voie depuis la rue. Il fallait nettoyer la
        toiture, puis refermer son sommet pour de bon.
      </p>
    </div>
    <figure class="media-figure">
      <img
        src={avant.src800}
        srcset={`${avant.src800} 800w, ${avant.src} 1200w`}
        sizes="(min-width: 780px) 360px, 100vw"
        alt={avant.alt}
        width="1200" height="1600" loading="lazy"
      />
      <figcaption>Avant : une couverture gagnée par la mousse.</figcaption>
    </figure>
  </div>

  <h2>Notre réponse, en deux temps</h2>
  <div class="media-row">
    <div>
      <ul class="chantier-points">
        <li>fin juin : nettoyage de toute la couverture, mousse et lichens retirés, fenêtres de toit dégagées ;</li>
        <li>début juillet : dépose des faîtières et purge du mortier fissuré ;</li>
        <li>pose d'une lisse de faîtage, puis d'un <strong>closoir ventilé</strong> qui suit la forme des tuiles ;</li>
        <li>faîtières reposées et <strong>fixées une à une</strong>, sans mortier ;</li>
        <li>raccord repris à la jonction avec le mur voisin.</li>
      </ul>
    </div>
    <figure class="media-figure">
      <img
        src={closoir.src800}
        srcset={`${closoir.src800} 800w, ${closoir.src} 1200w`}
        sizes="(min-width: 780px) 360px, 100vw"
        alt={closoir.alt}
        width="1200" height="1600" loading="lazy"
      />
      <figcaption>Le closoir ventilé, posé avant les faîtières.</figcaption>
    </figure>
  </div>

  <h2>Le résultat : une toiture propre et un faîtage qui ne bouge plus</h2>
  <p>
    Les tuiles ont retrouvé leur rouge, et le
    <strong>faîtage à sec</strong> ne dépend plus d'un mortier qui travaille
    avec le temps : le closoir assure l'étanchéité tout en laissant la
    toiture respirer. Au printemps 2026, nous sommes revenus sur cette même
    maison pour poser une
    <a href="/velux-fenetre-de-toit-78/">fenêtre de toit</a>, raccord
    d'étanchéité et tuiles reposées autour du cadre.
  </p>
  <p>
    Le <a href="/demoussage-de-toiture-78/">démoussage</a> et la
    <a href="/reparation-de-toiture-78/">réparation du faîtage</a> se
    combinent bien : une seule installation, une toiture remise en état du
    bas jusqu'au sommet. Francky et Warren,
    <a href="/couvreur-voisins-le-bretonneux/">couvreurs à
    Voisins-le-Bretonneux</a>, interviennent depuis leur bureau de
    Montigny-le-Bretonneux.
  </p>
</RealisationPage>
